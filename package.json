{
  "name": "al-deem-platform",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "docker:up": "docker compose -f infra/docker/compose.yaml up -d",
    "docker:down": "docker compose -f infra/docker/compose.yaml down",
    "db:migrate": "goose -dir services/core-api/migrations postgres \"$DATABASE_URL\" up",
    "db:status": "goose -dir services/core-api/migrations postgres \"$DATABASE_URL\" status",
    "api:dev": "air --config services/core-api/.air.toml",
    "api:build": "cd services/core-api && go build -o ../../bin/core-api ./cmd/api",
    "worker:build": "cd services/core-api && go build -o ../../bin/worker ./cmd/worker"
  },
  "devDependencies": {
    "turbo": "^2.10.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "unrs-resolver",
      "esbuild",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}