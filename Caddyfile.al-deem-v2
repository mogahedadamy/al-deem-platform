# alameedtraining.com — Al Deem Platform v2 (platform/ monorepo).
# Three Next.js apps (www/learn/erp) + Go core-api + Keycloak, all local ports.
#
# TLS: Let's Encrypt تلقائي (Caddy ACME) — يعمل مباشرة مع grey-cloud (DNS only).
# للسودان (بعض مزودي الخدمة يخنقون Cloudflare): اجعل السجلات DNS only.
# مع orange-cloud: إن فشل تحدي ACME عبر البروكسي، أعد تشغيل Caddy بعد grey.

(security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=(self), payment=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.alameedtraining.com https://auth.alameedtraining.com; media-src 'self' https: blob:; frame-src https://auth.alameedtraining.com https://*.zoom.us; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https:"
		-Server
	}
}

# الموقع الرسمي الجديد للمركز على النطاق الرئيسي.
alameedtraining.com {
	encode zstd gzip
	import security
	@static {
		path /_next/static/* /brand/* /courses/* /favicon.ico
	}
	header @static Cache-Control "public, max-age=604800, immutable"
	reverse_proxy 127.0.0.1:3011
}

# النطاق www موحد إلى النطاق الرسمي الرئيسي.
www.alameedtraining.com {
	redir https://alameedtraining.com{uri} permanent
}

# learn — منصة التعلّم للطلاب والمدربين
learn.alameedtraining.com {
	encode zstd gzip
	import security
	reverse_proxy 127.0.0.1:3012
}

# erp — النظام الإداري (المالية، المحتوى، المستخدمون، التقارير)
erp.alameedtraining.com {
	encode zstd gzip
	import security
	reverse_proxy 127.0.0.1:3013
}

# api — Go core-api
api.alameedtraining.com {
	encode zstd gzip
	import security
	reverse_proxy 127.0.0.1:4001
}

# auth — Keycloak SSO
auth.alameedtraining.com {
	encode zstd gzip
	import security
	reverse_proxy 127.0.0.1:8091
}
