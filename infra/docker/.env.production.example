# Copy to .env.production outside Git and use a secret manager in production.
DEEM_POSTGRES_PASSWORD=CHANGE_ME_generate_a_long_random_database_password
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_a_separate_long_random_password
# Student registration is enabled and requires a working production SMTP setup.
KC_ENABLE_STUDENT_SELF_REGISTRATION=true
KC_ENABLE_EMAIL_VERIFICATION=true
# Keep false for students; require MFA individually for privileged staff accounts.
KC_ENFORCE_GLOBAL_TOTP=false
# Published bank-transfer details for the learning app.
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_REFERENCE_HINT=
