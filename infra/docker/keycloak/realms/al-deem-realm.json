{
  "realm": "al-deem",
  "enabled": true,
  "displayName": "مركز العميد للتدريب",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "rememberMe": true,
  "verifyEmail": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["ar", "en"],
  "defaultLocale": "ar",
  "loginTheme": "alameed",
  "emailTheme": "alameed",
  "resetPasswordAllowed": true,
  "sslRequired": "external",
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10
    }
  ],
  "roles": {
    "realm": [
      { "name": "student", "description": "طالب — يتعلم ويطلب دورات" },
      { "name": "instructor", "description": "مدرب — يؤلف دورات ويديع طلابه" },
      { "name": "content_reviewer", "description": "مشرف محتوى — يراجع وينشر الدورات" },
      { "name": "finance_officer", "description": "موظف مالي مخصص — يراجع ويعتمد المدفوعات 24/7" },
      { "name": "support_agent", "description": "دعم فني — يساعد الطلاب" },
      { "name": "erp_staff", "description": "موظف إداري — عمليات ERP" },
      { "name": "erp_manager", "description": "مدير إداري — تقارير وإدارة عليا" },
      { "name": "system_admin", "description": "مدير النظام — إدارة كاملة" }
    ]
  },
  "groups": [
    {
      "name": "students",
      "path": "/students",
      "realmRoles": ["student"]
    }
  ],
  "defaultGroups": ["/students"],
  "clients": [
    {
      "clientId": "www",
      "name": "Al Deem Public Website",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3001/*", "https://www.alameedtraining.com/*"],
      "webOrigins": ["http://localhost:3001", "https://www.alameedtraining.com"],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "core-api-audience"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:3001/*+https://www.alameedtraining.com/*" }
    },
    {
      "clientId": "learn",
      "name": "Al Deem LMS",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3002/*", "https://learn.alameedtraining.com/*"],
      "webOrigins": ["http://localhost:3002", "https://learn.alameedtraining.com"],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "core-api-audience"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:3002/*+https://learn.alameedtraining.com/*" }
    },
    {
      "clientId": "erp",
      "name": "Al Deem ERP (Admin)",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3003/*", "https://erp.alameedtraining.com/*"],
      "webOrigins": ["http://localhost:3003", "https://erp.alameedtraining.com"],
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email", "core-api-audience"],
      "attributes": { "post.logout.redirect.uris": "http://localhost:3003/*+https://erp.alameedtraining.com/*" }
    },
    {
      "clientId": "core-api",
      "name": "Al Deem Core API (confidential)",
      "publicClient": false,
      "secret": "core-api-secret-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": [""]
    }
  ],
  "clientScopes": [
    {
      "name": "core-api-audience",
      "description": "Adds core-api as the access-token audience for server-side API verification.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "core-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "core-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "no-reply@alameedtraining.com",
    "fromDisplayName": "مركز العميد للتدريب",
    "starttls": "false",
    "auth": "false"
  }
}
