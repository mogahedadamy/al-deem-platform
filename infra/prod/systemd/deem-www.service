# www — الموقع العام (Next.js :3011)
[Unit]
Description=Al Deem www (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mojahed
Environment=PATH=/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/opt/deem/current/apps/www
ExecStart=/opt/deem/current/apps/www/node_modules/.bin/next start -p 3011
EnvironmentFile=/opt/deem/env/www.env
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
