# core-api — إنتاج
API_ADDR=:4001
DATABASE_URL=postgres://deem:CHANGE_ME@localhost:5435/deem?sslmode=disable
REDIS_URL=redis://localhost:6391/0
# Internal URL for JWKS fetch; issuer must match the public `iss` claim exactly.
KEYCLOAK_URL=http://localhost:8091
KEYCLOAK_ISSUER=https://auth.alameedtraining.com/realms/al-deem
KEYCLOAK_ALLOWED_CLIENTS=learn,erp,www,core-api
KEYCLOAK_REQUIRED_AUDIENCE=core-api
KEYCLOAK_REALM=al-deem
ZOOM_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
PRIVATE_STORAGE_DIR=/var/lib/deem/private
