# Backup encryption and off-host replication — production required values.
# Generate a 32+ byte random key once, store it outside Git at this 0600 path.
DEEM_BACKUP_KEY_FILE=/etc/deem/backup.key
# rclone remote/path; deployment refuses placeholders and backup fails closed if blank.
DEEM_BACKUP_OFFSITE_URI=CHANGE_ME_rclone_remote:alameedtraining-backups
DEEM_BACKUP_KEEP_DAYS=30
DEEM_PG_CONTAINER=deem-postgres
