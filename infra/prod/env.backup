# Backup encryption and off-host replication — production required values.
# Generate a 32+ byte random key once, store it outside Git at this 0600 path.
DEEM_BACKUP_KEY_FILE=/etc/deem/backup.key
# rclone remote/path; deployment refuses placeholders and backup fails closed if blank.
DEEM_BACKUP_OFFSITE_URI=CHANGE_ME_rclone_remote:alameedtraining-backups
DEEM_BACKUP_KEEP_DAYS=30
DEEM_PG_CONTAINER=deem-postgres
# Both databases live in the same production PostgreSQL container by default.
DEEM_POSTGRES_USER=deem
DEEM_APP_DATABASE=deem
DEEM_IDENTITY_DATABASE=zitadel
# Private payment receipts are never uploaded publicly; this directory is
# encrypted into each backup set before any off-host transfer.
DEEM_PRIVATE_RECEIPTS_DIR=/var/lib/deem/private/receipts
# Destructive restore drills are restricted to these explicitly disposable DBs.
DEEM_APP_RESTORE_DRILL_DB=deem_restore_drill
DEEM_IDENTITY_RESTORE_DRILL_DB=zitadel_restore_drill
# The backup service runs as root so it can read 0700/0600 receipt data. Keep
# rclone credentials in the deployment user's protected config file.
RCLONE_CONFIG=/home/mojahed/.config/rclone/rclone.conf
