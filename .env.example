# ===== Alameed Training Center — local development environment =====
# انسخ هذا الملف إلى .env.local (لا يُرفع أبدًا إلى Git)

# ---- core-api (Go) ----
API_ADDR=:4001
DATABASE_URL=postgres://deem:deem@localhost:5435/deem?sslmode=disable
REDIS_URL=redis://localhost:6391/0

# ---- Zitadel / OIDC ----
ZITADEL_MASTERKEY=replace-with-exactly-32-characters
ZITADEL_ADMIN_USERNAME=admin@alameedtraining.com
ZITADEL_ADMIN_PASSWORD=replace-with-random-password
OIDC_ISSUER=http://localhost:8091
OIDC_ALLOWED_CLIENTS=learn,erp,www,core-api
OIDC_REQUIRED_AUDIENCE=core-api
OIDC_CLIENT_ID=core-api
ZITADEL_ORG_ID=
ZITADEL_ADMIN_TOKEN=
AUTH_ZITADEL_ISSUER=http://localhost:8091
AUTH_ZITADEL_ID=
AUTH_ZITADEL_SECRET=
ZOOM_WEBHOOK_SECRET=replace-with-random-secret
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
PRIVATE_STORAGE_DIR=/var/lib/deem/private

# ---- apps (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4001/v1

# ---- payment instructions shown to students (published information) ----
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_REFERENCE_HINT=

# ---- Mailpit (dev SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=8093
SMTP_FROM=no-reply@alameedtraining.com
