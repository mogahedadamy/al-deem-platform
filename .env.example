# ===== al-deem platform — local development environment =====
# انسخ هذا الملف إلى .env.local (لا يُرفع أبدًا إلى Git)

# ---- core-api (Go) ----
API_ADDR=:4001
DATABASE_URL=postgres://deem:deem@localhost:5435/deem?sslmode=disable
REDIS_URL=redis://localhost:6391/0

# ---- Keycloak SSO ----
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-password
# JWKS endpoint may be internal, while KEYCLOAK_ISSUER must exactly match token `iss`.
KEYCLOAK_URL=http://localhost:8091
KEYCLOAK_ISSUER=http://localhost:8091/realms/al-deem
KEYCLOAK_ALLOWED_CLIENTS=learn,erp,www,core-api
# Token aud must include this API client (configured by the core-api audience mapper).
KEYCLOAK_REQUIRED_AUDIENCE=core-api
KEYCLOAK_REALM=al-deem
KEYCLOAK_CLIENT_ID=core-api
KEYCLOAK_CLIENT_SECRET=core-api-secret-change-me
ZOOM_WEBHOOK_SECRET=replace-with-random-secret
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
PRIVATE_STORAGE_DIR=/var/lib/deem/private

# ---- apps (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4001/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8091
NEXT_PUBLIC_KEYCLOAK_REALM=al-deem

# www
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=www
# learn
# learn uses NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=learn
# erp
# erp uses NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=erp

# ---- payment instructions shown to students (published information) ----
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_REFERENCE_HINT=

# ---- Mailpit (dev SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=8093
SMTP_FROM=no-reply@alameedtraining.com
