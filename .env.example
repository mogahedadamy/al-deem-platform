# ===== al-deem platform — local development environment =====
# انسخ هذا الملف إلى .env.local (لا يُرفع أبدًا إلى Git)

# ---- core-api (Go) ----
API_ADDR=:4001
DATABASE_URL=postgres://deem:deem@localhost:5435/deem?sslmode=disable
REDIS_URL=redis://localhost:6391/0

# ---- Keycloak SSO ----
KEYCLOAK_URL=http://localhost:8091
KEYCLOAK_REALM=al-deem
KEYCLOAK_CLIENT_ID=core-api
KEYCLOAK_CLIENT_SECRET=core-api-secret-change-me

# ---- apps (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4001/v1
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8091
NEXT_PUBLIC_KEYCLOAK_REALM=al-deem

# www
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=www
# learn
# learn uses NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=learn
# erp
# erp uses NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=erp

# ---- Mailpit (dev SMTP) ----
SMTP_HOST=localhost
SMTP_PORT=8093
SMTP_FROM=no-reply@alameedtraining.com
